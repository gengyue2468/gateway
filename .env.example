ACME_EMAIL=admin@example.com
CF_API_TOKEN=
# Optional: delegate _acme-challenge.www.gengyue.dev to this full DNS name.
# ACME_DNS_CHALLENGE_OVERRIDE_DOMAIN=_acme-challenge.cdnno.de
# Base difficulty for ordinary traffic. Higher risk tiers use +1, +2, and +3,
# capped at 64; extreme weight is denied.
ANUBIS_DIFFICULTY=4
# Authorization cookie lifetime. The default is 24 hours.
# ANUBIS_COOKIE_EXPIRATION_TIME=24h
