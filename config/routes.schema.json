{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gateway ingress routes",
  "description": "Cloudflared-inspired ingress rules rendered into Caddy configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "ingress"],
  "properties": {
    "version": {
      "const": 1
    },
    "ingress": {
      "type": "array",
      "minItems": 1,
      "description": "Rules are evaluated from top to bottom; the final rule must be the 444 catch-all. An empty gateway may contain only the catch-all.",
      "items": {
        "$ref": "#/$defs/route"
      }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(\\*\\.)?[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "description": "Exact hostname or a leading wildcard such as *.example.com."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "RE2-compatible path regular expression."
        },
        "service": {
          "description": "An http(s)/h2c upstream URL, a list of upstream URLs, or the final http_status:444 rule.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "redirect": {
          "type": "string",
          "minLength": 1,
          "description": "Client redirect target. The renderer emits a standard HTTP 302 response."
        },
        "rewrite": {
          "type": "string",
          "minLength": 1,
          "description": "Internal absolute-path rewrite applied before proxying."
        },
        "meta_redirect": {
          "type": "string",
          "minLength": 1,
          "description": "Explicit browser-only 200 HTML meta-refresh target. Do not use for HTTP-to-HTTPS or WebSocket routes."
        },
        "bypass_anubis": {
          "type": "boolean",
          "default": false,
          "description": "Send this path directly from edge Caddy to backend Caddy, retaining the backend WAF. Requires a path and cache: false when cache is specified."
        },
        "cache": {
          "type": "boolean",
          "default": true,
          "description": "Enable the shared GET/HEAD cache for this route."
        },
        "load_balance": {
          "type": "string",
          "enum": [
            "random",
            "first",
            "round_robin",
            "least_conn",
            "ip_hash",
            "client_ip_hash",
            "uri_hash"
          ],
          "default": "random"
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uri": {
              "type": "string",
              "minLength": 1,
              "default": "/healthz"
            },
            "interval": {
              "type": "string",
              "minLength": 1,
              "default": "30s"
            },
            "timeout": {
              "type": "string",
              "minLength": 1,
              "default": "5s"
            },
            "try_duration": {
              "type": "string",
              "minLength": 1,
              "default": "5s"
          }
        }
        }
      },
      "oneOf": [
        {
          "required": ["service"],
          "not": {
            "anyOf": [
              { "required": ["redirect"] },
              { "required": ["meta_redirect"] }
            ]
          }
        },
        {
          "required": ["redirect"],
          "not": {
            "anyOf": [
              { "required": ["service"] },
              { "required": ["rewrite"] },
              { "required": ["meta_redirect"] },
              { "required": ["bypass_anubis"] }
            ]
          }
        },
        {
          "required": ["meta_redirect"],
          "not": {
            "anyOf": [
              { "required": ["service"] },
              { "required": ["rewrite"] },
              { "required": ["redirect"] },
              { "required": ["bypass_anubis"] }
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": { "required": ["rewrite"] },
          "then": { "required": ["service"] }
        },
        {
          "if": { "required": ["bypass_anubis"] },
          "then": {
            "required": ["service", "path"],
            "properties": {
              "cache": { "const": false }
            }
          }
        }
      ]
    }
  }
}
