{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gateway ingress routes",
  "description": "Cloudflared-inspired ingress rules rendered into Caddy configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "ingress"],
  "properties": {
    "version": {
      "const": 1
    },
    "ingress": {
      "type": "array",
      "minItems": 1,
      "description": "Rules are evaluated from top to bottom; the final rule must be the 444 catch-all. An empty gateway may contain only the catch-all.",
      "items": {
        "$ref": "#/$defs/route"
      }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(\\*\\.)?[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "description": "Exact hostname or a leading wildcard such as *.example.com."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "RE2-compatible path regular expression. A route without hostname is backend-only and is not an edge bypass route."
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "CONNECT", "TRACE"]
          },
          "description": "Optional HTTP methods that must match this route."
        },
        "service": {
          "description": "An http(s)/h2c upstream URL, a list of upstream URLs, or the final http_status:444 rule.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "redirect": {
          "type": "string",
          "minLength": 1,
          "description": "Client redirect target. The renderer emits a standard HTTP 302 response."
        },
        "rewrite": {
          "type": "string",
          "minLength": 1,
          "description": "Internal absolute-path rewrite applied before proxying."
        },
        "meta_redirect": {
          "type": "string",
          "minLength": 1,
          "description": "Explicit browser-only 200 HTML meta-refresh target. Do not use for HTTP-to-HTTPS or WebSocket routes."
        },
        "bypass_anubis": {
          "type": "boolean",
          "default": false,
          "description": "Send this path directly from edge Caddy to the declared upstream, bypassing Anubis and edge Coraza/WAF. A configured route rate limit still applies. Requires hostname and path; bypass routes always disable cache and reject cache: true. Rewrite, load_balance, and an explicit health block are rendered on the edge route; an omitted health block retains the legacy no-probe behavior for direct routes."
        },
        "cache": {
          "type": "boolean",
          "default": false,
          "description": "Explicitly opt into the shared GET/HEAD cache for this public route. Requests with any Cookie or Authorization header bypass the cache; application cookies are never stripped. The response must not vary on an unkeyed request header."
        },
        "load_balance": {
          "type": "string",
          "enum": [
            "random",
            "first",
            "round_robin",
            "least_conn",
            "ip_hash",
            "client_ip_hash",
            "uri_hash"
          ],
          "default": "random"
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "active": {
              "type": "boolean",
              "default": true,
              "description": "Enable active HTTP health checks for this upstream."
            },
            "uri": {
              "type": "string",
              "minLength": 1,
              "default": "/healthz"
            },
            "interval": {
              "type": "string",
              "minLength": 1,
              "default": "30s"
            },
            "timeout": {
              "type": "string",
              "minLength": 1,
              "default": "5s"
            },
            "try_duration": {
              "type": "string",
              "minLength": 1,
              "default": "5s"
            }
          }
        },
        "rate_limit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "window", "events"],
          "description": "A per-client rate limit for a route that bypasses Anubis.",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "default": "{remote_host}"
            },
            "window": {
              "type": "string",
              "minLength": 1
            },
            "events": {
              "type": "integer",
              "minimum": 1
            },
            "methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "CONNECT", "TRACE"]
              },
              "description": "Optional HTTP methods to rate limit. Leave OPTIONS out of API quotas when CORS preflight must remain inexpensive."
            },
            "ipv4_prefix": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            },
            "ipv6_prefix": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            }
          }
        }
      },
      "oneOf": [
        {
          "required": ["service"],
          "not": {
            "anyOf": [
              { "required": ["redirect"] },
              { "required": ["meta_redirect"] }
            ]
          }
        },
        {
          "required": ["redirect"],
          "not": {
            "anyOf": [
              { "required": ["service"] },
              { "required": ["rewrite"] },
              { "required": ["meta_redirect"] },
              {
                "required": ["bypass_anubis"],
                "properties": { "bypass_anubis": { "const": true } }
              },
              { "required": ["cache"] },
              { "required": ["load_balance"] },
              { "required": ["health"] },
              { "required": ["rate_limit"] }
            ]
          }
        },
        {
          "required": ["meta_redirect"],
          "not": {
            "anyOf": [
              { "required": ["service"] },
              { "required": ["rewrite"] },
              { "required": ["redirect"] },
              {
                "required": ["bypass_anubis"],
                "properties": { "bypass_anubis": { "const": true } }
              },
              { "required": ["cache"] },
              { "required": ["load_balance"] },
              { "required": ["health"] },
              { "required": ["rate_limit"] }
            ]
          }
        }
      ],
      "allOf": [
        {
          "anyOf": [
            { "required": ["hostname"] },
            { "required": ["path"] },
            {
              "required": ["service"],
              "properties": { "service": { "const": "http_status:444" } }
            },
            {
              "required": ["service"],
              "properties": {
                "service": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": { "const": "http_status:444" }
                }
              }
            }
          ]
        },
        {
          "if": { "required": ["rewrite"] },
          "then": { "required": ["service"] }
        },
        {
          "if": { "required": ["rate_limit"] },
          "then": {
            "required": ["bypass_anubis"],
            "properties": { "bypass_anubis": { "const": true } }
          }
        },
        {
          "if": { "required": ["load_balance"] },
          "then": {
            "properties": {
              "service": {
                "type": "array",
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "required": ["service"],
            "properties": {
              "service": {
                "type": "array",
                "contains": { "const": "http_status:444" }
              }
            }
          },
          "then": {
            "properties": {
              "service": {
                "maxItems": 1,
                "items": { "const": "http_status:444" }
              }
            }
          }
        },
        {
          "if": {
            "required": ["bypass_anubis"],
            "properties": { "bypass_anubis": { "const": true } }
          },
          "then": {
            "required": ["service", "hostname", "path"],
            "properties": { "cache": { "const": false } }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": ["service"],
                "properties": { "service": { "const": "http_status:444" } }
              },
              {
                "required": ["service"],
                "properties": {
                  "service": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": { "const": "http_status:444" }
                  }
                }
              }
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["hostname"] },
                { "required": ["path"] },
                { "required": ["methods"] },
                { "required": ["redirect"] },
                { "required": ["rewrite"] },
                { "required": ["meta_redirect"] },
                {
                  "required": ["bypass_anubis"],
                  "properties": { "bypass_anubis": { "const": true } }
                },
                { "required": ["cache"] },
                { "required": ["load_balance"] },
                { "required": ["health"] },
                { "required": ["rate_limit"] }
              ]
            }
          }
        }
      ]
    }
  }
}
